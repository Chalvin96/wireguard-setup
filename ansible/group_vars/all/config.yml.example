# Copy to config.yml, fill in, then encrypt: ./run.sh edit-config does both.
# config.yml is committed vault-encrypted; this example documents every variable.
# ── Nodes ─────────────────────────────────────────────────────────────────────
ingress_ip: "1.2.3.4" # ingress node (VPS) public internet IP (also its Ansible address)
edge_ip: "192.168.1.x" # edge node LAN IP (Caddy admin bind + firewall)
monitoring_ip: "192.168.1.x" # monitoring node LAN IP (Prometheus scrape source)
tools_ip: "192.168.1.x" # tools VM LAN IP (Penpot bind address)
mikrotik_ip: "192.168.1.1" # router LAN IP (RouterOS SSH)
wireguard_lan_cidr: "192.168.1.0/24" # home LAN reachable by personal WireGuard clients through the edge node

# ── Operator access ───────────────────────────────────────────────────────────
# Public keys allowed to SSH as `deploy` on every host. Add a machine here and
# run `./run.sh bootstrap` from an already-authorized machine to enable it.
deploy_authorized_keys:
  - "ssh-ed25519 AAAA... you@laptop"

# ── Network ────────────────────────────────────────────────────────────────────
wireguard_server_ip: "10.8.0.1" # VPS WireGuard tunnel IP
wireguard_client_ip: "10.8.0.2" # edge node WireGuard tunnel IP (assigned to wg0 on Mini PC; Mikrotik routes traffic to it)
wireguard_port: 51820 # VPS WireGuard ListenPort

# ── Mikrotik (RouterOS over SSH) ────────────────────────────────────────────────
mikrotik_wireguard_interface: "wg-to-vps" # RouterOS WireGuard interface name
mikrotik_wireguard_mtu: 1420 # MTU adjusted for WireGuard overhead
mikrotik_peer_allowed_addresses: "10.8.0.1/32,10.8.0.3/32" # source IPs the VPS may use inside the tunnel
mikrotik_watchdog_interval: "2m" # tunnel health-check cadence
mikrotik_watchdog_cooldown: "60s" # disable window so stale CGNAT NAT mappings expire

# ── HAProxy ────────────────────────────────────────────────────────────────────
haproxy_http_port: 80
haproxy_https_port: 443
haproxy_rate_limit: 50 # max new connections per IP per 10s (TCP rate limit)

# ── Caddy ──────────────────────────────────────────────────────────────────────
caddy_domain: "example.com" # primary domain (placeholder for user's Caddyfile)
caddy_backend_port: 8088 # example backend port (avoid 8080 — used by CrowdSec LAPI)
# Sites Caddy serves (TLS via Cloudflare DNS-01, JSON access log for CrowdSec).
# Hand-written site files in /etc/caddy/conf.d/*.caddy keep working alongside these.
caddy_sites:
  - host: "sentry.example.com" # GlitchTip (Sentry-compatible) on monitoring-01
    upstream: "192.168.1.x:8000" # monitoring_ip:glitchtip_port

# ── fail2ban ───────────────────────────────────────────────────────────────────
fail2ban_ban_base: 300 # 5 minutes (seconds)
fail2ban_findtime: 60

# ── Observability ──────────────────────────────────────────────────────────────
loki_port: 3100
prometheus_port: 9090
grafana_port: 3000
glitchtip_port: 8000
node_exporter_port: 9100
grafana_disk_alert_threshold: 80 # percent
glitchtip_domain: "https://sentry.example.com" # must match its caddy_sites host
glitchtip_enable_admin: false
glitchtip_enable_openapi: false

# ── Image versions (pinned — change intentionally to upgrade) ──────────────────
loki_image: "grafana/loki:3.1.0"
prometheus_image: "prom/prometheus:v2.53.0"
grafana_image: "grafana/grafana:11.1.0"
glitchtip_image: "glitchtip/glitchtip:6.2.0"
glitchtip_postgres_image: "postgres:18.4"
glitchtip_valkey_image: "valkey/valkey:9.0.4"

# ── CrowdSec ───────────────────────────────────────────────────────────────────
crowdsec_lapi_port: 8080
crowdsec_hub_collections:
  - crowdsecurity/caddy
  - crowdsecurity/base-http-scenarios
  - crowdsecurity/http-cve
crowdsec_blocklist_image: "ghcr.io/wolffcatskyy/crowdsec-blocklist-import:latest" # pin to a digest in production
crowdsec_blocklist_feeds: "ipsum,spamhaus_drop,spamhaus_edrop,blocklistde,firehol_level1,firehol_level2,emerging_threats,dshield,ciarmy,talos,greensnow,stopforumspam,tor_exits"
crowdsec_blocklist_interval: "86400"

# ── Notifications (edge-01): Mailrise SMTP → Apprise → Discord ────────────────
# Internal only: send mail to <channel>@mailrise.lan at edge_ip:notify_port.
# Channel names are the keys of vault_notify_discord_webhooks.
notify_mailrise_version: "1.4.0" # PyPI release installed into /opt/mailrise/venv
notify_port: 8025
notify_mail_domain: "mailrise.lan" # senders mail <channel>@<this domain>

# ── Tools VM: Docker ──────────────────────────────────────────────────────────
docker_log_max_size: "10m"
docker_log_max_file: "3"
docker_prune_keep_storage: "20GB" # build cache kept after the weekly prune
docker_prune_image_age: "168h" # unused images older than this are removed
docker_apps_user: "apps" # shared daemon for Penpot and future trusted applications
docker_apps_home: "/var/lib/apps" # HDD bind mount from /srv/heavy-data/apps
docker_apps_subuid: 231072 # 65,536 subordinate UIDs/GIDs; must not overlap existing ranges
docker_ci_subuid: 296608 # CI has a separate mapping and daemon
docker_ci_cpu_quota: "300%" # aggregate: both runners AND their containers
docker_ci_memory_max: "4G"

# ── Tools VM: Penpot ──────────────────────────────────────────────────────────
penpot_version: "2.15.4"
penpot_postgres_image: "postgres:15"
penpot_valkey_image: "valkey/valkey:8.1"
penpot_port: 9001
penpot_public_uri: "http://192.168.1.x:9001"
# No SMTP is configured, so enable-smtp is intentionally absent.
penpot_flags: "disable-email-verification enable-prepl-server disable-secure-session-cookies" # role also enables MCP
penpot_dir: "/srv/penpot" # /srv = HDD data disk, mounted when the VM is created
penpot_backup_dir: "/srv/backups/penpot"
penpot_backup_keep_days: 7
penpot_backup_alert_recipient: "alerts@mailrise.lan" # Mailrise channel for failed backups

# ── Tools VM: GitHub Actions runners (PRIVATE repositories only) ──────────────
github_runner_version: "2.337.0"
github_runner_sha256: "70920811a4f8ad4328818682bca5c6469c1c942fab52448868071d0063816613"
github_runner_user: "github-runner"
github_runner_home: "/var/lib/actions-runner" # HDD bind mount from /srv/heavy-data/actions-runner
github_runner_tool_cache: "{{ github_runner_home }}/_tool" # shared by both runners
github_runner_node_versions: ["22.23.3", "24.21.0"] # seeded from nodejs.org with SHA-256 verification
github_runner_labels:
  - self-hosted
  - linux
  - ci
github_runner_cpu_quota: "400%" # 4 cores for processes the runner spawns directly
github_runner_memory_max: "10G"
github_runner_repos:
  - owner: "your-github-user"
    repo: "your-private-repo"
