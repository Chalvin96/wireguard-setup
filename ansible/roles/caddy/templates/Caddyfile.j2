# Managed by Ansible — do not edit manually
{
    admin 127.0.0.1:2019
    metrics
    acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}

    servers {
        protocols h1 h2 h3
        listener_wrappers {
            proxy_protocol {
                timeout 2s
                allow {{ wireguard_server_ip }}/32
            }
            tls
        }
    }
}

http://{{ edge_ip }}:2019 {
    bind {{ edge_ip }}
    route {
        metrics /metrics
        respond 404
    }
}

(access_log) {
    log {
        output file /var/log/caddy/access.log {
            mode 640
            roll_size 10mb
            roll_keep 14
        }
        format json
    }
}

import /etc/caddy/conf.d/*.caddy

# Rendered here, not in conf.d, so `caddy validate` checks them before reload.
{% for site in caddy_sites | default([]) %}
{{ site.host }} {
    import access_log
    reverse_proxy {{ site.upstream }}
}
{% endfor %}
