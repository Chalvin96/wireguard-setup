#!/bin/bash
set -euo pipefail
export PATH="${PATH:-/usr/bin:/bin}:/usr/sbin:/sbin"

# Every runner instance has its own account (user:home:name) and Docker daemon.
ci_accounts=(
{% for instance in github_runner_instances %}
    {{ (instance.user ~ ':' ~ instance.home ~ ':' ~ instance.name) | quote }}
{% endfor %}
)
runner_units=(
{% for instance in github_runner_instances %}
    {{ ('actions-runner@' ~ instance.name ~ '.service') | quote }}
{% endfor %}
)
frozen=()
started=0
exec 9>/run/lock/ci-cleanup.lock
flock -n 9 || exit 0

finish() {
    status=$?
    trap - EXIT
    for unit in "${frozen[@]}"; do
        systemctl thaw "$unit" || true
    done
    if (( started )); then
        temporary=/var/lib/prometheus/node-exporter/ci-cleanup.tmp
        printf 'ci_cleanup_success %s\nci_cleanup_last_run_timestamp_seconds %s\n' \
            "$((status == 0))" "$(date +%s)" > "$temporary"
        chmod 0644 "$temporary"
        mv "$temporary" /var/lib/prometheus/node-exporter/ci-cleanup.prom
    fi
    exit "$status"
}
trap finish EXIT
trap 'exit 1' HUP INT TERM

run_ci_docker() {
    runuser -u "$ci_user" -- docker --host "unix:///run/user/$ci_uid/docker.sock" "$@"
}

# Filesystem cleanup runs inside the daemon's user namespace as the runner user:
# it can remove files owned by container sub-UIDs but cannot follow a symlink
# swapped in by a surviving container to anything outside that account's data.
run_ci_ns() {
    local pid
    pid=$(cat "/run/user/$ci_uid/dockerd-rootless/child_pid")
    runuser -u "$ci_user" -- nsenter -U --preserve-credentials -t "$pid" "$@"
}

select_account() {
    IFS=: read -r ci_user ci_home ci_name <<< "$1"
    ci_uid=$(id -u "$ci_user")
}

for unit in "${runner_units[@]}"; do
    if systemctl is-active --quiet "$unit"; then
        frozen+=("$unit")
        systemctl freeze "$unit"
    fi
done
for account in "${ci_accounts[@]}"; do
    select_account "$account"
    if pgrep -u "$ci_uid" -x Runner.Worker >/dev/null; then
        echo 'CI cleanup skipped: a job is active.'
        exit 0
    else
        result=$?
        (( result == 1 )) || exit "$result"
    fi
done
started=1

for account in "${ci_accounts[@]}"; do
    select_account "$account"
    run_ci_docker container prune --force
    run_ci_docker volume prune --force
    volumes=$(run_ci_docker volume ls --filter dangling=true --format '{{ '{{.Name}}' }}')
    while IFS= read -r volume; do
        case "$volume" in
            buildx_buildkit_*_state) run_ci_docker volume rm "$volume" ;;
        esac
    done <<< "$volumes"

    run_ci_docker image prune --force
    run_ci_docker buildx prune --builder default --force --max-used-space {{ ci_build_cache_budget }}
    builders=$(run_ci_docker buildx ls --format '{{ '{{json .}}' }}' |
        python3 -c 'import json, sys; rows = (json.loads(line) for line in sys.stdin if line.strip()); print("\n".join(sorted({row["Name"] for row in rows if row["Driver"] == "docker-container"})))')
    while IFS= read -r builder; do
        [[ -n "$builder" ]] || continue
        run_ci_docker buildx prune --builder "$builder" --force --max-used-space {{ ci_build_cache_budget }}
    done <<< "$builders"

    retention={{ ci_cache_retention_days }}
    cache_dirs=(
        "$ci_home/$ci_name/_work/.pnpm-store"
        "$ci_home/.cache" "$ci_home/.npm" "$ci_home/.local/share/pnpm/store"
    )
    for dir in "${cache_dirs[@]}"; do
        [[ -d "$dir" ]] || continue
        run_ci_ns find "$dir" -xdev -mindepth 1 \( -type f -atime "+$retention" -o -type d -empty \) -delete
    done
    work="$ci_home/$ci_name/_work"
    if [[ -d "$work" ]]; then
        run_ci_ns find "$work" -xdev -mindepth 1 -maxdepth 1 -type d ! -name '_*' ! -name '.*' \
            -mtime "+$retention" -exec rm -rf --one-file-system -- {} +
    fi
    if [[ -d "$ci_home/_tool" ]]; then
        run_ci_ns find "$ci_home/_tool" -mindepth 1 -maxdepth 1 -type d -name 'trivy-*' -mtime "+$retention" \
            -exec rm -rf --one-file-system -- {} +
    fi
done
df -h /srv
