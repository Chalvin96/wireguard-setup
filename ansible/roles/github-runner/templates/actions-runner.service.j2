# Managed by Ansible — runner for {{ item.repo }}
[Unit]
Description=GitHub Actions runner ({{ item.repo }})
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service

[Service]
# Docker access is root-equivalent anyway; running as root keeps workspace
# files written by containers removable by the runner.
User=root
Slice=ci.slice
Environment=RUNNER_TOOL_CACHE={{ github_runner_tool_cache }}
Environment=HOME={{ github_runner_home }}
Environment=RUNNER_ALLOW_RUNASROOT=1
# A private temp dir: under the shared /tmp, files one job leaves behind (e.g. a
# pnpm store at /tmp/.pnpm-store) break others. Inside the home it also stays on
# the same filesystem as the runner's caches.
Environment=TMPDIR={{ github_runner_home }}/tmp
ExecStartPre=/usr/bin/install -d -m 0700 {{ github_runner_home }}/tmp
WorkingDirectory={{ github_runner_home }}/{{ item.repo }}
ExecStart={{ github_runner_home }}/{{ item.repo }}/run.sh
Restart=always
RestartSec=10
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
