# Managed by Ansible — one instance per repository: actions-runner@<repo>
[Unit]
Description=GitHub Actions runner (%i)
Wants=network-online.target
After=network-online.target docker.service

[Service]
User={{ github_runner_user }}
WorkingDirectory={{ github_runner_home }}/%i
ExecStart={{ github_runner_home }}/%i/run.sh
Restart=always
RestartSec=10
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min
# Caps processes the runner spawns directly (npm, uv, pytest). Containers
# started through the Docker daemon are NOT covered by these limits.
CPUQuota={{ github_runner_cpu_quota }}
MemoryMax={{ github_runner_memory_max }}

[Install]
WantedBy=multi-user.target
