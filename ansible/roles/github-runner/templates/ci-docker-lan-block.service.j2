# Managed by Ansible. CI containers are for this host only, but Actions service
# containers publish their ports on 0.0.0.0: drop new connections to them from
# the LAN interface.
[Unit]
Description=Block LAN access to CI containers
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=true
{% for tool in ['/usr/sbin/iptables', '/usr/sbin/ip6tables'] %}
ExecStart=/bin/sh -c '{{ tool }} -C DOCKER-USER -i {{ github_runner_lan_interface }} -m conntrack --ctstate NEW -j DROP 2>/dev/null || {{ tool }} -I DOCKER-USER -i {{ github_runner_lan_interface }} -m conntrack --ctstate NEW -j DROP'
{% endfor %}
{% for tool in ['/usr/sbin/iptables', '/usr/sbin/ip6tables'] %}
ExecStop=-{{ tool }} -D DOCKER-USER -i {{ github_runner_lan_interface }} -m conntrack --ctstate NEW -j DROP
{% endfor %}

[Install]
WantedBy=docker.service
