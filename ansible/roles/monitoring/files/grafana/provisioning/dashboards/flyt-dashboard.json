{
  "uid": "flyt",
  "title": "Flyt",
  "tags": ["flyt"],
  "schemaVersion": 38,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Word linking (Jev)",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 4,
      "title": "Requests by outcome",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 20
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(flyt_contextual_requests_total{job=\"flyt\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Tokens by kind",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(flyt_contextual_tokens_total{job=\"flyt\"}[5m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Annotation failures by reason (1h)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": null,
          "expr": "sum by (reason) (increase(flyt_contextual_annotation_failures_total{job=\"flyt\"}[1h]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Annotations exhausted (24h)",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": null,
          "expr": "sum(increase(flyt_contextual_annotation_exhausted_total{job=\"flyt\"}[24h]))",
          "legendFormat": "exhausted"
        }
      ]
    },
    {
      "id": 9,
      "title": "Mean page latency",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(flyt_contextual_page_seconds_sum{job=\"flyt\"}[5m])) / clamp_min(sum(rate(flyt_contextual_page_seconds_count{job=\"flyt\"}[5m])), 1e-9)",
          "legendFormat": "Mean"
        }
      ]
    },
    {
      "id": 10,
      "title": "API",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      }
    },
    {
      "id": 11,
      "title": "Target up",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 30
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"flyt\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 12,
      "title": "Request rate by status class",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 18,
        "x": 6,
        "y": 30
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total{job=\"flyt\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "5xx ratio",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_requests_total{job=\"flyt\",status=\"5xx\"}[5m])) or 0 * sum(rate(http_requests_total{job=\"flyt\"}[5m]))) / clamp_min(sum(rate(http_requests_total{job=\"flyt\"}[5m])), 1e-9)",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 14,
      "title": "p95 request latency",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"flyt\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
