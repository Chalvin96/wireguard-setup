# Managed by Ansible
services:
  loki:
    image: {{ loki_image }}
    restart: unless-stopped
    volumes:
      - ./loki-config.yml:/etc/loki/local-config.yaml:ro
      - ./loki-data:/loki
    ports:
      - "{{ monitoring_ip }}:{{ loki_port }}:3100"
    command: -config.file=/etc/loki/local-config.yaml

  prometheus:
    image: {{ prometheus_image }}
    restart: unless-stopped
    extra_hosts:
      - "host-gateway:host-gateway"
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
{% if app_backend_metrics_enabled | default(false) %}
      - ./app-metrics-token:/etc/prometheus/app-metrics-token:ro
{% endif %}
      - ./prometheus-data:/prometheus
    ports:
      - "{{ monitoring_ip }}:{{ prometheus_port }}:9090"
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.retention.time=14d
      - --storage.tsdb.path=/prometheus

  grafana:
    image: {{ grafana_image }}
    restart: unless-stopped
    environment:
      GF_SECURITY_ADMIN_USER: "{{ vault_grafana_admin_user }}"
      GF_SECURITY_ADMIN_PASSWORD: "{{ vault_grafana_admin_password }}"
      GF_PATHS_PROVISIONING: /etc/grafana/provisioning
    volumes:
      - ./grafana-data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
    ports:
      - "{{ monitoring_ip }}:{{ grafana_port }}:3000"
    depends_on:
      - loki
      - prometheus

  glitchtip-postgres:
    image: {{ glitchtip_postgres_image }}
    restart: unless-stopped
    environment:
      POSTGRES_PASSWORD: "{{ vault_glitchtip_postgres_password }}"
    volumes:
      - glitchtip-postgres-data:/var/lib/postgresql

  glitchtip-valkey:
    image: {{ glitchtip_valkey_image }}
    restart: unless-stopped
    volumes:
      - glitchtip-valkey-data:/data

  glitchtip:
    image: {{ glitchtip_image }}
    restart: unless-stopped
    depends_on:
      - glitchtip-postgres
      - glitchtip-valkey
    environment:
      DATABASE_URL: "postgres://postgres:{{ vault_glitchtip_postgres_password }}@glitchtip-postgres:5432/postgres"
      VALKEY_URL: redis://glitchtip-valkey:6379
      SECRET_KEY: "{{ vault_glitchtip_secret_key }}"
      EMAIL_URL: "{{ vault_glitchtip_email_url }}"
      GLITCHTIP_DOMAIN: "{{ glitchtip_domain }}"
      DEFAULT_FROM_EMAIL: "{{ vault_glitchtip_default_from_email }}"
      ENABLE_ADMIN: "{{ glitchtip_enable_admin | ternary('True', 'False') }}"
      ENABLE_OPENAPI: "{{ glitchtip_enable_openapi | ternary('True', 'False') }}"
      SERVER_ROLE: all_in_one
    ports:
      - "{{ monitoring_ip }}:{{ glitchtip_port }}:8000"
    volumes:
      - glitchtip-uploads:/code/uploads

volumes:
  glitchtip-postgres-data:
  glitchtip-valkey-data:
  glitchtip-uploads:
