# Managed by Ansible
apiVersion: 1
contactPoints:
  - orgId: 1
    name: discord
    receivers:
      - uid: discord-webhook
        type: discord
        settings:
          url: "{{ vault_grafana_discord_webhook }}"
          title: '{% raw %}{{ template "homelab.discord.title" . }}{% endraw %}'
          message: '{% raw %}{{ template "homelab.discord.message" . }}{% endraw %}'
        disableResolveMessage: false
