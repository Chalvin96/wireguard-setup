apiVersion: 1
groups:
  - orgId: 1
    name: {{ health_alert_group }}
    folder: Homelab
    interval: 1m
    rules:
{% for alert in health_alerts %}
      - uid: {{ alert.uid }}
        title: {{ alert.title | to_json }}
        condition: C
        data:
          - refId: A
            relativeTimeRange: {from: 900, to: 0}
            datasourceUid: prometheus
            model:
              expr: {{ alert.expression | to_json }}
              instant: true
              refId: A
          - refId: B
            relativeTimeRange: {from: 0, to: 0}
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
              refId: B
          - refId: C
            relativeTimeRange: {from: 0, to: 0}
            datasourceUid: __expr__
            model:
              type: math
              expression: "$B {{ alert.operator | default('>') }} {{ alert.threshold }}"
              refId: C
        noDataState: {{ alert.no_data | default(health_alert_no_data) }}
        execErrState: Error
        for: {{ alert.duration }}
        annotations:
          summary: {{ alert.title | to_json }}
          measurement: {{ ('{{ with $values.A }}' ~ alert.measurement ~ '{{ end }}') | to_json }}
          description: {{ alert.action | to_json }}
        labels:
{% for key, value in health_alert_labels.items() %}
          {{ key }}: {{ value }}
{% endfor %}
          severity: {{ alert.severity }}
        isPaused: false
{% endfor %}
