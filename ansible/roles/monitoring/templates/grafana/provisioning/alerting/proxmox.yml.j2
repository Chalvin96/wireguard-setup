apiVersion: 1
groups:
  - orgId: 1
    name: proxmox-health
    folder: Homelab
    interval: 1m
    rules:
{% for alert in monitoring_proxmox_alerts %}
      - uid: {{ alert.uid }}
        title: {{ alert.title | to_json }}
        condition: C
        data:
          - refId: A
            relativeTimeRange: {from: 900, to: 0}
            datasourceUid: prometheus
            model:
              expr: {{ alert.expression | to_json }}
              instant: true
              refId: A
          - refId: B
            relativeTimeRange: {from: 0, to: 0}
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
              refId: B
          - refId: C
            relativeTimeRange: {from: 0, to: 0}
            datasourceUid: __expr__
            model:
              type: math
              expression: "$B > {{ alert.threshold }}"
              refId: C
        noDataState: {{ alert.no_data | default('OK') }}
        execErrState: Error
        for: {{ alert.duration }}
        annotations:
          summary: {{ alert.title | to_json }}
          measurement: {{ ('{{ with $values.A }}' ~ alert.measurement ~ '{{ end }}') | to_json }}
          description: {{ alert.action | to_json }}
        labels:
          service: proxmox
          severity: {{ alert.severity }}
        isPaused: false
{% endfor %}
