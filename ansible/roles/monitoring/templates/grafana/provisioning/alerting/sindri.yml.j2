{% set alerts = [
  {'uid': 'sindri-storage-warning', 'title': 'Sindri data disk exceeds 90 GB', 'expr': '(node_filesystem_size_bytes{job="sindri",mountpoint="/srv"} - node_filesystem_free_bytes{job="sindri",mountpoint="/srv"}) / 1000000000', 'threshold': 90, 'duration': '10m', 'severity': 'warning', 'measurement': 'Used: {{ printf "%.1f" $values.A.Value }} GB (warning above 90 GB).', 'action': 'Check CI cleanup status and retained build data.'},
  {'uid': 'sindri-storage-critical', 'title': 'Sindri data disk exceeds 100 GB', 'expr': '(node_filesystem_size_bytes{job="sindri",mountpoint="/srv"} - node_filesystem_free_bytes{job="sindri",mountpoint="/srv"}) / 1000000000', 'threshold': 100, 'duration': '5m', 'severity': 'critical', 'measurement': 'Used: {{ printf "%.1f" $values.A.Value }} GB (critical above 100 GB).', 'action': 'Check CI cleanup and remove disposable build data.'},
  {'uid': 'sindri-storage-free', 'title': 'Sindri data disk has less than 20 GiB available', 'expr': 'node_filesystem_avail_bytes{job="sindri",mountpoint="/srv"} / 1073741824', 'threshold': 20, 'duration': '5m', 'severity': 'critical', 'measurement': 'Available: {{ printf "%.1f" $values.A.Value }} GiB (minimum 20 GiB).', 'action': 'Free disposable CI storage before applications run out of space.', 'operator': '<'},
  {'uid': 'sindri-storage-inodes', 'title': 'Sindri data disk inode usage exceeds 85 percent', 'expr': '100 * (1 - node_filesystem_files_free{job="sindri",mountpoint="/srv"} / node_filesystem_files{job="sindri",mountpoint="/srv"})', 'threshold': 85, 'duration': '5m', 'severity': 'warning', 'measurement': 'Inodes used: {{ printf "%.1f" $values.A.Value }}% (warning above 85%).', 'action': 'Check retained workspaces and files created by builds.'},
  {'uid': 'sindri-exporter-down', 'title': 'Sindri host metrics unavailable', 'expr': '1 - up{job="sindri"}', 'threshold': 0, 'duration': '3m', 'severity': 'critical', 'measurement': '', 'action': 'Check the node and its metrics exporter.'},
  {'uid': 'sindri-io-pressure', 'title': 'Sindri sustained disk IO pressure', 'expr': '100 * rate(node_pressure_io_waiting_seconds_total{job="sindri"}[5m])', 'threshold': 20, 'duration': '10m', 'severity': 'warning', 'measurement': 'I/O stall time: {{ printf "%.1f" $values.A.Value }}% (warning above 20%).', 'action': 'Check disk latency and competing workloads.'},
  {'uid': 'sindri-penpot-api', 'title': 'Sindri Penpot API probe failed', 'expr': '1 - sindri_penpot_api_up{job="sindri"}', 'threshold': 0, 'duration': '2m', 'severity': 'critical', 'measurement': '', 'action': 'Check Penpot frontend, backend and database health.'},
  {'uid': 'sindri-penpot-latency', 'title': 'Sindri Penpot API slower than two seconds', 'expr': 'sindri_penpot_api_duration_seconds{job="sindri"}', 'threshold': 2, 'duration': '5m', 'severity': 'warning', 'measurement': 'API response: {{ printf "%.2f" $values.A.Value }} s (limit 2 s).', 'action': 'Check Penpot database connections and host load.'},
  {'uid': 'sindri-penpot-database', 'title': 'Sindri Penpot database query failed', 'expr': '1 - sindri_penpot_database_up{job="sindri"}', 'threshold': 0, 'duration': '1m', 'severity': 'critical', 'measurement': '', 'action': 'Check PostgreSQL health and available storage.'},
  {'uid': 'sindri-cleanup-failed', 'no_data': 'OK', 'title': 'Sindri CI cleanup failed', 'expr': '1 - ci_cleanup_success{job="sindri"}', 'threshold': 0, 'duration': '1m', 'severity': 'warning', 'measurement': '', 'action': 'Check the ci-cleanup journal for the failed command.'},
  {'uid': 'sindri-cleanup-stale', 'no_data': 'OK', 'title': 'Sindri CI cleanup overdue', 'expr': 'time() - ci_cleanup_last_run_timestamp_seconds{job="sindri"}', 'threshold': 21600, 'duration': '15m', 'severity': 'warning', 'measurement': 'Last cleanup attempt: {{ humanizeDuration $values.A.Value }} ago (limit 6 h).', 'action': 'Check cron, active CI jobs and the ci-cleanup journal.'},
  {'uid': 'sindri-health-stale', 'title': 'Sindri Penpot health collector overdue', 'expr': 'time() - sindri_health_last_run_timestamp_seconds{job="sindri"}', 'threshold': 180, 'duration': '2m', 'severity': 'critical', 'measurement': 'Last probe: {{ humanizeDuration $values.A.Value }} ago (limit 3 min).', 'action': 'Check the Penpot health collector timer.'}
] %}
# Managed by Ansible
apiVersion: 1
groups:
  - orgId: 1
    name: sindri-health
    folder: Homelab
    interval: 1m
    rules:
{% for alert in alerts %}
      - uid: {{ alert.uid }}
        title: {{ alert.title | to_json }}
        condition: C
        data:
          - refId: A
            relativeTimeRange: {from: 900, to: 0}
            datasourceUid: prometheus
            model:
              expr: {{ alert.expr | to_json }}
              instant: true
              refId: A
          - refId: B
            relativeTimeRange: {from: 0, to: 0}
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
              refId: B
          - refId: C
            relativeTimeRange: {from: 0, to: 0}
            datasourceUid: __expr__
            model:
              type: math
              expression: "$B {{ alert.operator | default('>') }} {{ alert.threshold }}"
              refId: C
        noDataState: {{ alert.no_data | default('Alerting') }}
        execErrState: Error
        for: {{ alert.duration }}
        annotations:
          summary: {{ alert.title | to_json }}
          measurement: {{ ('{{ with $values.A }}' ~ alert.measurement ~ '{{ end }}') | to_json }}
          description: {{ alert.action | to_json }}
        labels:
          host: tools-01
          service: sindri
          severity: {{ alert.severity }}
        isPaused: false
{% endfor %}
