# Managed by Ansible
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: caddy
    static_configs:
      - targets:
          - "{{ edge_ip }}:2019"

  - job_name: node-exporter
    static_configs:
      - targets:
          - "host-gateway:{{ node_exporter_port }}"

  - job_name: sindri
    static_configs:
      - targets:
          - "{{ tools_ip }}:{{ node_exporter_port }}"
        labels:
          host: tools-01
