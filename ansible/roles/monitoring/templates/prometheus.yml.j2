# Managed by Ansible
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
{% if proxmox_ip is defined %}
  - job_name: proxmox
    static_configs:
      - targets:
          - "{{ proxmox_ip }}:9100"
        labels:
          host: proxmox
{% endif %}
  - job_name: caddy
    static_configs:
      - targets:
          - "{{ edge_ip }}:2019"

  - job_name: node-exporter
    static_configs:
      - targets:
          - "host-gateway:{{ node_exporter_port }}"

  - job_name: sindri
    static_configs:
      - targets:
          - "{{ tools_ip }}:{{ node_exporter_port }}"
        labels:
          host: tools-01

  - job_name: ci
    static_configs:
      - targets:
          - "{{ ci_ip }}:{{ node_exporter_port }}"
        labels:
          host: ci-01
{% if flyt_metrics_target is defined %}

  - job_name: flyt
    scheme: https
    authorization:
      type: Bearer
      credentials_file: /etc/prometheus/secrets/flyt_metrics_token
    static_configs:
      - targets:
          - "{{ flyt_metrics_target }}"
{% endif %}
