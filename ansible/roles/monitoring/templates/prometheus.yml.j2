# Managed by Ansible
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: caddy
    static_configs:
      - targets:
          - "{{ edge_ip }}:{{ caddy_admin_port }}"

  - job_name: node-exporter
    static_configs:
      - targets:
          - "host-gateway:{{ node_exporter_port }}"
