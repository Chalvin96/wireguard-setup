# Managed by Ansible
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: caddy
    static_configs:
      - targets:
          - "{{ edge_ip }}:2019"

  - job_name: node-exporter
    static_configs:
      - targets:
          - "host-gateway:{{ node_exporter_port }}"

{% if app_backend_metrics_enabled | default(false) %}
  - job_name: app-backend
    metrics_path: "{{ app_backend_metrics_path | default('/metrics') }}"
    scheme: "{{ app_backend_metrics_scheme | default('https') }}"
    authorization:
      type: Bearer
      credentials_file: /etc/prometheus/app-metrics-token
    static_configs:
      - targets:
{% for target in app_backend_metrics_targets | default([]) %}
          - "{{ target }}"
{% endfor %}
{% endif %}
